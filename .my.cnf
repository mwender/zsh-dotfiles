# MySQL client defaults: read by mysql, mysqladmin and mysqldump, not by PHP.
#
# host forces TCP. The MacBook's server is DBngin's, which listens on
# /tmp/mysql_3306.sock rather than the /tmp/mysql.sock the Homebrew client
# looks for, so a socket connection fails.
#
# This repo is public: never put a password here. Use ~/.mylogin.cnf
# (mysql_config_editor) for that.
[client]
user=root
host=127.0.0.1
