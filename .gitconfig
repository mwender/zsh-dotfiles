[alias]

	# gitimmersion.com
	co = checkout
	ci = commit
	st = status
	br = branch
	hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
	type = cat-file -t
	dump = cat-file -p

[user]

	name = Michael Wender
	email = michael@michaelwender.com
[credential "https://github.com"]
	helper =
[credential "https://github"]
	com = !gh auth git-credential
[credential]
	helper = !gh auth git-credential
