# Create a new directory and enter it
mkd() {
  mkdir -p -- "$1" && cd -- "$1"
}

# Copy a file or directory's absolute path to the clipboard
cpath() {
  [[ $# -gt 0 ]] || return 1
  realpath "$1" | pbcopy
}

compdef _files cpath

# Run TinyPNG on an image
shrinkpng(){
  pngquant --quality 70-90 --speed 1 -v --ext .png --force $1
}

# Pretty print your directories
# Install `tree` first - brew install tree
function t(){
  # Defaults to 3 levels deep, do more with `t 5` or `t 1`
  # pass additional args after
  tree -I '.git|node_modules|bower_components|.DS_Store' --dirsfirst --filelimit 15 -L ${1:-3} -aC $2
}

# Rename files in current dir (spaces to underscores, remove chars like `{}(),\!`, and all lowercase)
function renamefiles(){
  ls | while read -r FILE
  do
      mv -v "$FILE" `echo $FILE | tr ' ' '_' | tr -d '[{}(),\!]' | tr -d "\'" | tr '[A-Z]' '[a-z]' | sed 's/_-_/_/g'`
  done
}

# OpenClaw dashboard tunnel + open in browser
openclawdash() {
  # ---- config ----
  local remote_host="macmini@wenmark-macmini.local"
  local local_port="18789"
  local remote_bind="127.0.0.1"
  local remote_port="18789"

  # Where your dashboard lives once tunneled locally.
  # Tip: you can append /#token=... if you want to paste a token manually.
  local url="http://localhost:${local_port}/"

  # ---- derived ----
  local ctl_sock="/tmp/openclaw-dash-${local_port}.sock"

  # If a control master is already up, reuse it.
  if ssh -S "${ctl_sock}" -O check "${remote_host}" >/dev/null 2>&1; then
    print "🦞 OpenClaw tunnel already running on localhost:${local_port}"
  else
    print "🦞 Starting OpenClaw tunnel..."
    ssh \
      -M -S "${ctl_sock}" \
      -f -N \
      -L "${local_port}:${remote_bind}:${remote_port}" \
      -o ExitOnForwardFailure=yes \
      -o ServerAliveInterval=30 \
      -o ServerAliveCountMax=3 \
      "${remote_host}" || return 1
    print "✅ Tunnel up: http://localhost:${local_port}/"
  fi

  # Open in your default browser (macOS).
  command -v open >/dev/null 2>&1 && open "${url}" >/dev/null 2>&1
}

# Jump into ~/webdev/laravel-valet/bedrock, or a tab-completable site subdir within it
BEDROCK_ROOT="$HOME/webdev/laravel-valet/bedrock"

bedrock() {
  if [[ $# -eq 0 ]]; then
    cd -- "$BEDROCK_ROOT" || return 1
    return
  fi

  local target="$BEDROCK_ROOT/$1"
  if [[ -d "$target" ]]; then
    cd -- "$target"
  else
    echo "bedrock: no such site '$1' in $BEDROCK_ROOT" >&2
    return 1
  fi
}

_bedrock() {
  local -a sites
  sites=("$BEDROCK_ROOT"/*(/N:t))
  _describe 'bedrock site' sites
}

compdef _bedrock bedrock

# Optional: stop the tunnel cleanly
openclawdash_stop() {
  local remote_host="macmini@wenmark-macmini.local"
  local local_port="18789"
  local ctl_sock="/tmp/openclaw-dash-${local_port}.sock"

  if ssh -S "${ctl_sock}" -O check "${remote_host}" >/dev/null 2>&1; then
    ssh -S "${ctl_sock}" -O exit "${remote_host}" >/dev/null 2>&1
    print "🛑 OpenClaw tunnel stopped."
  else
    print "ℹ️ No OpenClaw tunnel found."
  fi
}

# Pick a project via the launchpad TUI, cd into it, and start Claude Code.
# When Claude Code exits, you're left at a normal prompt in that directory
# (a subprocess can't change its parent shell's directory after it exits,
# so the cd has to happen here rather than in the launchpad binary itself).
launchpad() {
  local dir
  dir="$(command launchpad)" || return
  [[ -z "$dir" ]] && return
  cd -- "$dir" || return
  claude --dangerously-skip-permissions
}

# Short alias for launchpad
lpd() {
  launchpad "$@"
}

# Start Claude code with the name of the current dir
claude() {
    command claude -n "$(basename "$PWD")" "$@"
  }
