#!/usr/bin/env bash
#
# proj — make a project reachable, or open it in a terminal.
#
#   proj                    fuzzy-pick a project, then open a shell in it
#   proj <name>             open a shell in <name>'s session, creating it if needed
#   proj <name> claude      make <name> reachable from the Claude app, and return
#                           to your prompt — no terminal to attach to or detach from
#   proj <name> codex       start Codex in <name>'s session and attach
#   proj -r                 bring up every project listed as resident
#   proj -R                 restart every running server, then as -r
#   proj login              renew the claude.ai login (~monthly), then as -R
#   proj -l                 list projects, marking live sessions, servers and residents
#   proj -k <name>          kill <name>'s session
#
# `proj <name> claude` starts a Remote Control *server* — the `claude
# remote-control` subcommand, not the `--remote-control` flag. The server holds
# no conversation of its own; it registers an environment, and the Claude app
# creates sessions inside it on demand. There is nothing to sit in, which is the
# point: the old flag mirrored one interactive session, so any stray Ctrl-C in
# the terminal killed what the app was looking at.
#
# An environment must exist before the app can reach a project. Without one the
# app silently falls back to a *cloud* session and asks you to select a GitHub
# repository — which looks like a permissions failure and is not one.
#
# Resident projects are listed one per line in ~/.config/proj/resident and are
# brought up together by `proj -r`, which a LaunchAgent runs at login. A line
# may add a path, for a project that lives outside the projects directory:
#
#   hoperedefined.org   ~/webdev/bedrock/hoperedefined.org
#
# The name is what the server is called in the Claude app, and what `proj -r`
# looks for to decide whether it is already up.
#
# Set PROJ_NO_REMOTE_CONTROL=1 to get the old behaviour instead: an ordinary
# interactive Claude Code session in tmux, continuing this directory's last
# conversation, which you attach to.
#
# The claude.ai login lapses about monthly. `proj -l` and `hello` warn, every
# start refuses while it has, and `proj login` renews it and restarts the
# servers -- from the MacBook, `pm login`.
#
set -uo pipefail

# Answer --help before checking anything: asking how a command works should
# not require its dependencies to be installed.
case "${1:-}" in
  -h|--help) sed -n '2,43p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

ROOT="${PROJECTS_DIR:-$HOME/Projects}"
[ -d "$ROOT" ] || { echo "No such directory: $ROOT" >&2; exit 1; }
command -v tmux >/dev/null || { echo "tmux is not installed" >&2; exit 1; }

# ~/.local/bin holds the Claude Code shim and is missing from non-login PATHs.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH

RC_LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/proj"
RESIDENT_FILE="${PROJ_RESIDENT_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/proj/resident}"

projects() { find "$ROOT" -mindepth 1 -maxdepth 1 -type d -exec test -d '{}/.git' ';' -print \
             | sed "s|^$ROOT/||" | sort; }
# tmux treats '.' and ':' as address separators.
sess_name() { printf '%s' "$1" | tr '.:' '__'; }
has_sess()  { tmux has-session -t "=$1" 2>/dev/null; }

# Comments and blank lines let the list carry a note about why something is on it.
# Each line comes out as "<name>" or "<name> <path>", whitespace normalised.
resident_list() {
  [ -f "$RESIDENT_FILE" ] || return 0
  sed 's/#.*//' "$RESIDENT_FILE" | awk 'NF { $1=$1; print }'
}
is_resident() { resident_list | awk -v n="$1" '$1 == n { found=1 } END { exit !found }'; }

# Resident entries that carry their own path: the ones `proj -l` cannot find by
# walking the projects directory, so it lists them separately.
resident_elsewhere() { resident_list | awk 'NF > 1'; }

expand_home() { case "$1" in "~") printf '%s' "$HOME" ;; "~/"*) printf '%s/%s' "$HOME" "${1#\~/}" ;; *) printf '%s' "$1" ;; esac; }

# The server puts the project name on its own command line, so ask the process
# table rather than tracking state in a file that could go stale. Match on the
# claude process itself: any shell whose command line merely mentions the name
# -- tmux's wrapper, an ssh one-liner, a grep -- would otherwise count as up.
rc_running() {
  local pid
  for pid in $(pgrep -f -- "remote-control --name $1 " 2>/dev/null); do
    case "$(ps -p "$pid" -o comm= 2>/dev/null)" in claude|*/claude) return 0 ;; esac
  done
  return 1
}

rc_log() { printf '%s/%s-rc.log' "$RC_LOG_DIR" "$1"; }

# The Mini's claude.ai login lapses on its own when the refresh token expires,
# and nothing announces it: a new server exits in a second, and running ones
# keep their process -- and their "remote control" mark -- while every
# heartbeat returns 401. So check the login itself.
#
# The credential is in the login keychain, which a bare SSH session cannot
# read: `claude auth status` run straight from `pm` says logged out even when
# it is not. The tmux server was started from the GUI login and can read it,
# so ask it. With no tmux server yet, ask directly -- right at the Mini's own
# terminal, and the best available otherwise.
with_keychain() { # with_keychain <shell command>
  if tmux list-sessions >/dev/null 2>&1; then tmux run-shell "$1"
  else                                        bash -c "$1"; fi
}

logged_in() {
  local bin; bin=$(command -v claude) || return 1
  with_keychain "$(printf '%q auth status >/dev/null 2>&1' "$bin")" >/dev/null 2>&1
}

# When the login stops being renewable: the refresh token's expiry, in epoch
# seconds, or 0 when logged out. Only the number leaves the keychain.
login_expiry() {
  local ms
  ms=$(with_keychain "security find-generic-password -s 'Claude Code-credentials' -w 2>/dev/null \
         | grep -o '\"refreshTokenExpiresAt\":[0-9]*' | cut -d: -f2" 2>/dev/null)
  if [ -n "$ms" ] && logged_in; then echo $(( ms / 1000 )); else echo 0; fi
}

# `hello` warns before the login lapses, on both machines. It cannot afford to
# ask the keychain itself -- the MacBook would need SSH on every new shell --
# so the expiry is written here whenever proj has checked, which the resident
# LaunchAgent does every half hour, and `hello` reads the file.
LOGIN_FILE="$RC_LOG_DIR/login-expires"
record_login() {
  mkdir -p "$RC_LOG_DIR" && login_expiry > "$LOGIN_FILE.tmp" && mv "$LOGIN_FILE.tmp" "$LOGIN_FILE"
}

login_help() {
  cat >&2 <<'MSG'
proj: Claude Code on this machine is not logged in to claude.ai, so no Remote
      Control server can start. Log in again, which also restarts the servers:

        pm login       from the MacBook
        proj login     at the Mini itself
MSG
}

# Log in again without the user ever meeting tmux. `claude auth login` has to
# run where the keychain is writable, which a bare SSH session is not, so it
# runs in a detached tmux session; its URL is read off the pane and shown here,
# and the code typed here is sent to its waiting prompt.
do_login() {
  local bin sess=claude-login pane url code i status exp
  bin=$(command -v claude) || { echo "'claude' is not installed or not on PATH." >&2; return 1; }

  exp=$(login_expiry)
  if [ "$exp" -gt 0 ]; then
    printf 'Logged in; the login lapses on %s (%d days).\n' \
      "$(date -r "$exp" '+%a %b %-d, %H:%M')" $(( (exp - $(date +%s)) / 86400 ))
    printf 'Logging in again now resets that to about 30 days.\n'
  else
    printf 'Not logged in to claude.ai. No Remote Control server here can work until you are.\n'
  fi
  printf '\nContinue? [Y/n] '; read -r i
  case "$i" in n|N|no) return 0 ;; esac

  tmux kill-session -t "=$sess" 2>/dev/null
  # BROWSER=true: the Mini has a screen nobody is looking at; opening a sign-in
  # tab there would only leave it behind.
  tmux new-session -d -s "$sess" -x 400 -y 50 -c "$HOME" \
    "BROWSER=true $(printf '%q' "$bin") auth login --claudeai; echo \"proj-login-exit=\$?\"; sleep 600" || return 1

  for i in $(seq 1 40); do
    pane=$(tmux capture-pane -p -J -t "$sess" 2>/dev/null)
    url=$(printf '%s\n' "$pane" | grep -o 'https://[^ ]*oauth/authorize[^ ]*' | head -1)
    [ -n "$url" ] && break
    sleep 0.5
  done
  if [ -z "$url" ]; then
    echo "proj: the login never offered a URL. What it showed:" >&2
    printf '%s\n' "$pane" | grep -v '^$' >&2
    tmux kill-session -t "=$sess" 2>/dev/null; return 1
  fi

  printf '\n1. Open this in a browser on any machine, signed in to your claude.ai account:\n\n%s\n\n' "$url"
  printf '2. Approve, then paste the code it shows here: '
  read -r code
  [ -n "$code" ] || { echo "No code; nothing changed."; tmux kill-session -t "=$sess" 2>/dev/null; return 1; }
  tmux send-keys -t "$sess" -l "$code"
  tmux send-keys -t "$sess" Enter

  for i in $(seq 1 60); do
    pane=$(tmux capture-pane -p -J -t "$sess" 2>/dev/null)
    status=$(printf '%s\n' "$pane" | sed -n 's/^proj-login-exit=//p' | tail -1)
    [ -n "$status" ] && break
    sleep 0.5
  done
  tmux kill-session -t "=$sess" 2>/dev/null
  if [ "$status" != 0 ] || ! logged_in; then
    echo "proj: the login did not take. What it showed:" >&2
    printf '%s\n' "$pane" | grep -v -e '^$' -e 'oauth/authorize' >&2
    return 1
  fi

  record_login
  printf '\nLogged in; good until %s.\n\n3. Restarting the servers against it:\n' \
    "$(date -r "$(cat "$LOGIN_FILE")" '+%a %b %-d')"
  restart_all
}

# A server's process outliving its login is the failure the process table
# cannot see. Its log can: whichever came last, a token refresh or an auth
# failure, says whether it is still able to work.
rc_auth_failed() { # rc_auth_failed <name>
  local last
  last=$(grep -E 'Refreshing token for|Updated access token|Refresh chain exhausted|Authentication failed|must be logged in' \
           "$(rc_log "$1")" 2>/dev/null | tail -1)
  case "$last" in *exhausted*|*"Authentication failed"*|*"must be logged in"*) return 0 ;; esac
  return 1
}

# Every running server, one "<pid> <name>" per line.
rc_servers() {
  local pid name
  for pid in $(pgrep -f -- 'remote-control --name ' 2>/dev/null); do
    case "$(ps -p "$pid" -o comm= 2>/dev/null)" in claude|*/claude) ;; *) continue ;; esac
    name=$(ps -p "$pid" -o args= | sed -n 's/.*remote-control --name \([^ ]*\).*/\1/p')
    [ -n "$name" ] && printf '%s %s\n' "$pid" "$name"
  done
}

rc_pid() { rc_servers | awk -v n="$1" '$2 == n { print $1; exit }'; }

# Stop a server and close the tmux pane it ran in, so a restart does not leave
# an idle shell window behind. The pane's own process is the server's parent:
# the `zsh -c` wrapper start_rc hands tmux, or the shell of a server started by
# hand.
stop_rc() { # stop_rc <pid>
  local ppid pane
  ppid=$(ps -p "$1" -o ppid= 2>/dev/null | tr -d ' ')
  pane=$(tmux list-panes -a -F '#{pane_pid} #{pane_id}' 2>/dev/null | awk -v p="$ppid" '$1 == p { print $2; exit }')
  if [ -n "$pane" ]; then tmux kill-pane -t "$pane"; else kill "$1" 2>/dev/null; fi
  sleep 0.5
}

# Claude Code files a directory's transcripts under a key built by replacing
# every "/" and "." in the absolute path with "-".
transcript_dir() { printf '%s/.claude/projects/%s' "$HOME" "$(printf '%s' "$1" | tr './' '--')"; }

has_prior_conversation() { # has_prior_conversation <project dir>
  local d; d="$(transcript_dir "$1")"
  [ -d "$d" ] || return 1
  set -- "$d"/*.jsonl
  [ -e "$1" ]
}

# tmux reports the wrapper shell as pane_current_command, not the agent running
# inside it, so ask the panes' child processes instead.
session_runs() { # session_runs <session> <needle>
  local sess="$1" needle="$2" pid kid
  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    for kid in $(pgrep -P "$pid" 2>/dev/null); do
      case "$(ps -p "$kid" -o comm= 2>/dev/null)" in
        *"$needle"*) return 0 ;;
      esac
    done
  done < <(tmux list-panes -s -t "=$sess" -F '#{pane_pid}' 2>/dev/null)
  return 1
}

enter() {  # enter <session>
  if [ -n "${TMUX:-}" ]; then tmux switch-client -t "=$1"; else tmux attach-session -t "=$1"; fi
}

# Start the Remote Control server for a project in its tmux session, detached.
# The log is truncated per start: it exists to explain the session in front of
# you, and `--debug-file` is the only place a registration failure shows up --
# the pane itself cheerfully reports "Ready" while every session creation fails.
start_rc() { # start_rc <name> <dir> <session>
  local name="$1" dir="$2" sess="$3" bin log cmd
  bin=$(command -v claude) || { echo "'claude' is not installed or not on PATH." >&2; return 1; }
  log=$(rc_log "$name")
  mkdir -p "$RC_LOG_DIR" && : > "$log"
  # --spawn must be explicit. Without it the subcommand asks interactively which
  # spawn mode to use, and a session created detached is never attached, so it
  # waits on that prompt forever while looking perfectly healthy.
  printf -v cmd '%q remote-control --name %q --spawn same-dir --permission-mode bypassPermissions --debug-file %q --verbose; exec %q -l' \
    "$bin" "$name" "$log" "${SHELL:-/bin/zsh}"
  if has_sess "$sess"; then tmux new-window -d -t "=$sess" -c "$dir" "$cmd"
  else                      tmux new-session -d -s "$sess" -c "$dir" "$cmd"; fi
}

# Registration takes a second or two. Wait for it rather than printing nothing,
# because the environment id is the one piece of evidence that it worked.
rc_url() { # rc_url <name>
  local log id i
  log=$(rc_log "$1")
  for i in $(seq 1 40); do
    id=$(grep -ho 'environment_id=env_[A-Za-z0-9]*' "$log" 2>/dev/null | tail -1 | cut -d= -f2)
    [ -n "$id" ] && { printf 'https://claude.ai/code?environment=%s\n' "$id"; return 0; }
    # A server that failed to start is gone within a second or two; don't wait
    # out the full twenty for it.
    [ "$i" -gt 6 ] && ! rc_running "$1" && return 1
    sleep 0.5
  done
  return 1
}

# Resolve a possibly-partial name to a real project directory.
resolve() { # resolve <name>
  local name="$1" match
  [ -d "$ROOT/$name" ] && { printf '%s' "$name"; return 0; }
  match=$(projects | grep -ix -- "$name" || projects | grep -i -- "$name" | head -1)
  [ -n "$match" ] || return 1
  printf '%s' "$match"
}

# Bring up every resident project that is not already serving. Already-running
# ones are left alone, so this is safe to run again -- which is what makes it
# fit a LaunchAgent.
bring_up_residents() {
  local n=0 p path name dir
  while read -r p path; do
    [ -n "$p" ] || continue
    if [ -n "$path" ]; then
      # An explicit path: taken as given, name and all. Checking the name
      # first means a server started by hand under that name is adopted,
      # not duplicated.
      name="$p"; dir=$(expand_home "$path")
      [ -d "$dir" ] || { echo "proj -r: '$name' points at $dir, which does not exist" >&2; continue; }
    else
      name=$(resolve "$p") || { echo "proj -r: no project matching '$p'" >&2; continue; }
      dir="$ROOT/$name"
    fi
    if rc_running "$name"; then
      printf '  = %s (already up)\n' "$name"
    else
      start_rc "$name" "$dir" "$(sess_name "$name")" \
        && { printf '  + %s\n' "$name"; n=$((n+1)); }
    fi
  done < <(resident_list)
  [ "$n" -gt 0 ] && printf '\nBrought up %d project(s). They are in the Claude app now.\n' "$n"
  return 0
}

# Restart every running server, then bring up any resident one that is down.
# This is the step after a fresh login: a server reads the login once at
# start, so one that lost it never recovers on its own.
restart_all() {
  local servers pid name dir
  servers=$(rc_servers)
  while read -r pid name; do
    [ -n "$pid" ] || continue
    dir=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')
    [ -d "$dir" ] || { echo "proj -R: cannot tell where '$name' runs; left alone" >&2; continue; }
    stop_rc "$pid"
    start_rc "$name" "$dir" "$(sess_name "$name")" && printf '  ↻ %s\n' "$name"
  done <<< "$servers"
  bring_up_residents
}

# A server's label in `proj -l`: running is not the same as working.
rc_mark() { # rc_mark <name>
  rc_running "$1" || return 0
  if rc_auth_failed "$1"; then printf 'remote control (auth failed)'
  else                         printf 'remote control'; fi
}

case "${1:-}" in
  -l|--list)
    record_login
    [ "$(cat "$LOGIN_FILE" 2>/dev/null || echo 0)" -gt 0 ] || printf '\n  \033[31m! Not logged in to claude.ai — no server here can work. Run `pm login`.\033[0m\n\n'
    while IFS= read -r p; do
      marks=$(rc_mark "$p")
      is_resident "$p" && marks="${marks:+$marks, }resident"
      if has_sess "$(sess_name "$p")"; then printf '  \033[32m*\033[0m %-32s %s\n' "$p" "$marks"
      else                                  printf '    %-32s %s\n' "$p" "$marks"; fi
    done < <(projects)
    if [ -n "$(resident_elsewhere)" ]; then
      echo; echo "  Outside $ROOT:"
      while read -r name path; do
        marks=$(rc_mark "$name")
        marks="${marks:+$marks, }resident"
        printf '    %-32s %s  (%s)\n' "$name" "$marks" "$path"
      done < <(resident_elsewhere)
    fi
    echo; echo "  * = live tmux session"
    exit 0 ;;
  -r|--resident)
    # Starting servers while logged out only produces servers that exit at
    # once, every half hour when the LaunchAgent runs this.
    record_login
    logged_in || { login_help; exit 1; }
    bring_up_residents
    exit 0 ;;
  -R|--restart)
    logged_in || { login_help; exit 1; }
    record_login
    restart_all
    exit 0 ;;
  login|--login)
    do_login; exit $? ;;
  -k|--kill)
    [ $# -ge 2 ] || { echo "usage: proj -k <name>" >&2; exit 2; }
    s=$(sess_name "$2")
    has_sess "$s" || { echo "No session for '$2'." >&2; exit 1; }
    tmux kill-session -t "=$s" && echo "Killed session '$s'."
    exit 0 ;;
esac

NAME="${1:-}"
AGENT="${2:-}"
FRESH="${3:-}"   # "new" forces a fresh conversation / an extra agent window

if [ -z "$NAME" ]; then
  command -v fzf >/dev/null || { echo "fzf not installed; pass a project name, or: brew install fzf" >&2; exit 1; }
  NAME=$(projects | fzf --height=40% --reverse --prompt='project> ' \
          --preview="sed -n '1,40p' $ROOT/{}/README.md 2>/dev/null \
                  || sed -n '1,40p' $ROOT/{}/AGENTS.md 2>/dev/null \
                  || ls -1 $ROOT/{}" \
          --preview-window=right:55%)
  [ -n "$NAME" ] || exit 0
fi

NAME=$(resolve "$NAME") || { echo "No project matching '${1:-}' under $ROOT" >&2; exit 1; }
DIR="$ROOT/$NAME"
SESS=$(sess_name "$NAME")

# Claude is the one agent that does not end in an attached terminal, so it is
# handled here and exits rather than falling through to `enter`.
if [ "$AGENT" = claude ] && [ -z "${PROJ_NO_REMOTE_CONTROL:-}" ]; then
  [ "$FRESH" = new ] && echo "proj: 'new' has no meaning for a Remote Control server — the app creates the sessions." >&2
  logged_in || { login_help; exit 1; }
  if rc_running "$NAME" && ! rc_auth_failed "$NAME"; then
    printf "'%s' is already reachable from the Claude app.\n" "$NAME"
  else
    # Running but locked out since a login lapsed: replace it, don't adopt it.
    if pid=$(rc_pid "$NAME") && [ -n "$pid" ]; then
      stop_rc "$pid"; printf "Replacing '%s', whose server had lost its login.\n" "$NAME"
    fi
    start_rc "$NAME" "$DIR" "$SESS" || exit 1
    printf "Started Remote Control for '%s'.\n" "$NAME"
  fi
  if url=$(rc_url "$NAME"); then
    printf '  %s\n' "$url"
  elif ! rc_running "$NAME"; then
    printf '  The server exited — see %s, or the pane: tmux attach -t %s\n' "$(rc_log "$NAME")" "$SESS" >&2
    exit 1
  else
    printf '  Registration has not shown up yet — check %s\n' "$(rc_log "$NAME")" >&2
  fi
  printf '  In the Claude app, pick it from the environment chip beside the composer.\n'
  exit 0
fi

# Resolve the agent to an absolute path here, while PATH is known good. The
# tmux server may have been started with a different environment, and a bare
# name would be looked up there instead.
# Hand back to a login shell when the agent exits, so the session survives and
# keeps its working directory.
BACK_TO_SHELL="exec ${SHELL:-/bin/zsh} -l"

AGENT_CMD=""
case "$AGENT" in
  ""|shell) ;;
  claude)
    # Only reached under PROJ_NO_REMOTE_CONTROL: an ordinary interactive session.
    AGENT_BIN=$(command -v claude) || {
      echo "'claude' is not installed or not on PATH." >&2; exit 1; }
    # Rejoin the directory's last conversation rather than starting over. A
    # project that lives on this machine is usually being returned to, not
    # begun, and a fresh session would silently lose the thread.
    if [ "$FRESH" != new ] && has_prior_conversation "$DIR"; then
      AGENT_CMD="$AGENT_BIN --continue; $BACK_TO_SHELL"
    else
      AGENT_CMD="$AGENT_BIN; $BACK_TO_SHELL"
    fi
    ;;
  codex)
    AGENT_BIN=$(command -v codex) || {
      echo "'codex' is not installed or not on PATH." >&2; exit 1; }
    # Codex has `codex resume --last`, but its per-directory session layout is
    # not something this script can detect reliably, so it starts fresh. Resume
    # by hand from inside the session.
    AGENT_CMD="$AGENT_BIN; $BACK_TO_SHELL"
    ;;
  *)
    echo "Unknown agent '$AGENT' (expected: claude, codex, shell)." >&2; exit 2 ;;
esac

if ! has_sess "$SESS"; then
  # Pass the command to new-session rather than send-keys: send-keys races the
  # shell's startup and the keystrokes are silently swallowed.
  if [ -n "$AGENT_CMD" ]; then
    tmux new-session -d -s "$SESS" -c "$DIR" "$AGENT_CMD" || exit 1
  else
    tmux new-session -d -s "$SESS" -c "$DIR" || exit 1
  fi
elif [ -n "$AGENT_CMD" ]; then
  if [ "$FRESH" != new ] && session_runs "$SESS" "$AGENT"; then
    # Already running there. Attaching is what "open my project" means; a second
    # copy would fight the first over the same conversation.
    printf "%s is already running in '%s' — attaching.\n" "$AGENT" "$SESS" >&2
  else
    tmux new-window -t "=$SESS" -c "$DIR" "$AGENT_CMD"
  fi
fi

enter "$SESS"
