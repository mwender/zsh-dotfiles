# --- Navigation ---
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias -- -='cd -'
alias cpwd='pwd | pbcopy'
alias d='cd ~/Dropbox'

# --- ls (macOS / BSD sane defaults) ---
# -G = enable color
# -F = classify
alias ls='command ls -G'
alias l='ls -lF'
alias ll='ls -lahF'
alias llc='ls -lahFC'
alias la='ls -laF'

# Directories only
alias lsd="ls -lF | grep '^d'"

alias wh="cd ~/Dropbox/WenderHost"
alias wm="cd ~/Dropbox/Wenmark"
alias web="cd ~/webdev/laravel-valet"
alias sourcetree='open -a SourceTree'
alias bennettshare="cd ~/wenmark-on-bennett"

# Misc
#alias combine='"$HOME/Dropbox/Projects/harvest-to-whmcs/bin/combine"'
alias combine='bun run /Users/mwender/Dropbox/Projects/harvest-to-whmcs/src/index.tsx'
alias unlockkeychain='security unlock-keychain ~/Library/Keychains/login-keychain.db'
